{
    "name": "@doki-land/prometheus-harness",
    "version": "0.0.1",
    "description": "MCP tools and CLI for authoring Prometheus plugins",
    "license": "CC0-1.0",
    "type": "module",
    "bin": {
        "prometheus-harness": "./bin/prometheus-harness.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "bin",
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "node --test tests/harness.test.mjs"
    },
    "dependencies": {
        "@doki-land/prometheus-plugin": "workspace:*",
        "@doki-land/prometheus-torch": "workspace:*",
        "commander": "^13.1.0"
    },
    "devDependencies": {
        "@types/node": "^22.15.0",
        "typescript": "^5.8.3"
    },
    "engines": {
        "node": ">=20"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oovm/prometheus-downloader.git"
    },
    "keywords": [
        "prometheus",
        "mcp",
        "plugin"
    ]
}
